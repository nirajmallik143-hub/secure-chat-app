NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nepal:nepal@localhost:5432/nepalconnect?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
CORS_ORIGIN=*
# S3-compatible storage (AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nepalconnect
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_PUBLIC_URL=http://localhost:9000/nepalconnect

# Comma separated emails allowed to train the AI tutor (add knowledge entries)
ADMIN_EMAILS=admin@example.com
# AI tutor LLM (any OpenAI-compatible API). Leave AI_API_KEY empty to answer from the knowledge base only.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
